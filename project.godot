config_version=5
[application]
config/name="Hexbound Kingdoms"
config/version="0.1.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"
[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025,0.055,0.085,1)
[input_devices]
pointing/emulate_mouse_from_touch=true
[editor_plugins]
enabled=PackedStringArray("res://addons/hexbound_android/plugin.cfg")
[admob]
general/android/enabled=false
general/android/app_id="ca-app-pub-3940256099942544~3347511713"
general/ios/enabled=false
